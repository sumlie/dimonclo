{
  "name": "dimonclo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "pnpm format:check && turbo run lint",
    "format": "prettier --write .",
    "check-types": "turbo run check-types",
    "lint:fix": "pnpm -r --if-present run lint --fix && pnpm format",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "2.10.12",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "^24.22.3 || >=26.13.1"
  }
}
